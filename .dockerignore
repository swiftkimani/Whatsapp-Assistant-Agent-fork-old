# Keep the build context to source only. Everything excluded here is either
# rebuilt in the image, supplied as an environment variable, or a volume.

.git/
.gitignore
.github/

# Rebuilt inside the image
venv/
__pycache__/
**/__pycache__/
*.pyc
node_modules/
whatsapp-bridge/node_modules/

# Secrets and runtime state: environment variables and volumes instead
.env
.env.*
!.env.example
data/
# The linked WhatsApp session. Nothing COPYs it, so it never reached a layer,
# but 106 MB of live credential material was being handed to the Docker daemon
# on every build for no reason. The bridge's own copy was already excluded;
# this is the one at the repository root.
.wwebjs_auth/
**/.wwebjs_auth/
backups/
contacts.json
whatsapp-bridge/.wwebjs_auth/
whatsapp-bridge/.wwebjs_cache/

# Not needed at runtime
tests/
docs/
scripts/dev.sh
.DS_Store
