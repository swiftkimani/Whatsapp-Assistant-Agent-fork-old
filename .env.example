# Copy to .env and fill in. .env is gitignored; never commit the real values.
# The bold rows in the README's Configuration table are the ones you must set.

# ---- Model (replies and Arianna) ----
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth and token spend: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Ceiling for one reply. Thinking tokens are drawn from it, so keep it well
# above the length of the reply itself.
ANTHROPIC_MAX_TOKENS=8192

# The owner's name: the assistant replies AS this person, and treats a message
# that is just this name as someone calling for attention. Set it.
USER_NAME=

# ---- Dashboard ----
# Plaintext, for a dashboard only reachable over loopback.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_PASSWORD=
# An argon2id hash of the password instead. Required once the dashboard is
# reachable from anywhere but this machine: it is the only form that survives
# someone reading the environment. When set, the plaintext above is ignored.
# Generate with: python scripts/hash_password.py
# DASHBOARD_PASSWORD_HASH=
# The same hash, base64-encoded, and it wins when both are set. Use this on any
# platform that interpolates $NAME inside environment values (Coolify, and
# anything else routing values through Docker Compose): an argon2 hash is made
# of "$" separators, so a raw one arrives shredded and rejects every password.
# DASHBOARD_PASSWORD_HASH_B64=
# The older name for DASHBOARD_PASSWORD, still read when that one is unset.
# Kept so an existing .env keeps working; prefer the names above.
# DASHBOARD_TOKEN=
# true when reached through a tunnel, so per-IP lockouts use the real client IP
TRUST_PROXY=false
# Arianna's name (the wake-word spellings are in app/dashboard.html)
ASSISTANT_NAME=Arianna
# Short forms she also answers to, comma-separated. The wake-word spellings
# live in app/dashboard.html.
ASSISTANT_NICKNAMES=Arie

# ---- Bridge <-> backend ----
# Shared secret, checked in both directions. Generate it the same way.
BRIDGE_API_TOKEN=
BRIDGE_API_URL=http://127.0.0.1:3001
BRIDGE_API_PORT=3001
BACKEND_URL=http://localhost:8000/webhook
# The bridge's send API binds loopback, so nothing off this machine can reach
# it. Only containers change that: under compose the backend is a different
# host, and docker-compose.yaml sets this to 0.0.0.0 on a private network.
# BRIDGE_API_HOST=127.0.0.1

# ---- Browser for the bridge ----
# whatsapp-web.js drives a real Chrome. Puppeteer's own browser download failed
# to extract here, so point it at the installed Chrome instead and install the
# bridge with: PUPPETEER_SKIP_DOWNLOAD=true npm install
# Quoted because the path contains spaces and scripts/dev.sh sources this file.
PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# false shows the browser window. Linking a new device now needs a WebAuthn
# step a headless container cannot perform, so a first link is done on a
# laptop with this off and the session folder is then moved to the server.
# See "Done — linking" in docs/CONTEXT.md for the procedure.
# HEADLESS=true

# ---- Who gets answered ----
# Comma-separated phone numbers, no "+", and/or one of two words:
#   contacts  everyone in your address book (contacts.json) — the only setting
#             that stays right as you sync new contacts
#   anyone    everyone who writes, saved or not
# You can mix numbers with either: "contacts,254700000001".
# EMPTY MEANS EVERYONE, including strangers, so set it before going live —
# "anyone" is how you say that on purpose rather than by forgetting.
# With "contacts", an empty or unreadable address book means nobody.
#
# This decides only who REACHES the assistant. What they get is the per-person
# choice on the Contacts tab, and "Anyone not chosen" there covers everyone who
# has no entry of their own — which is every stranger. With "anyone" here and
# "Leave alone" there, the assistant reaches everybody and answers nobody.
ALLOWED_CONTACTS=anyone
ALLOW_GROUPS=false
# Link by typing an 8-character code instead of scanning a QR. Set this to the
# number of the account being linked, digits only, no "+". The code lasts about
# three minutes; a QR lasts twenty seconds. Leave empty to use the QR.
# PAIRING_NUMBER=
# The WhatsApp Web build the bridge loads. The library pins an old one, and
# WhatsApp refuses to link a NEW device on a stale build while existing
# sessions keep working — it reports that as "Couldn't link device". Pick a
# recent one from github.com/wppconnect-team/wa-version/tree/main/html
# WA_WEB_VERSION=2.3000.1052866173-alpha
# Where contacts.json lives. The project root by default; compose points both
# containers at one copy on a shared volume.
# CONTACTS_FILE=
# How many contacts one sync may add. contacts.json is the list the dashboard
# is allowed to message, so a sync widens it; this bounds how far.
# CONTACTS_SYNC_LIMIT=500
# Where the bridge reports that a conversation changed, so an open dashboard
# updates at once. Derived from BACKEND_URL; set it only if they differ.
# ACTIVITY_URL=http://localhost:8000/wa-event
# Where the bridge asks whether replies are actually going out, so it does not
# show "typing…" for a reply that will be held. Derived the same way.
# STATE_URL=http://localhost:8000/agent-state

# ---- Replying ----
# Exchanges of past conversation given to the model. The first time someone
# writes, the thread is pulled from WhatsApp itself so the first reply is not
# written blind; SEED_HISTORY=false turns that off.
HISTORY_TURNS=12
# SEED_HISTORY=true
# Hours when replies are written and held rather than sent, local time. A reply
# at 3am reads as a bot. Empty switches it off; the range may wrap midnight.
# QUIET_HOURS=22:00-07:00
# Show "typing…" while the model works. Only honest when replies are actually
# going out, so the bridge checks first and stays quiet when they are not.
# TYPING_INDICATOR=true

# ---- Voice notes and dictation (faster-whisper, local) ----
# Whisper's language hint. English does better than Swahili on short clips,
# and most Kenyan voice notes are English or a mix. "sw" biases the other way.
STT_LANGUAGE=en
WHISPER_MODEL_SIZE=small
DASHBOARD_WHISPER_SIZE=small
# How long a loaded Whisper or BLIP model may sit unused before the next voice
# note or photo drops it and loads it again. A "small" Whisper holds ~600 MiB
# and BLIP ~1 GB, so a quiet afternoon used to cost that for nothing; the price
# of the window expiring is a few seconds on the next one. 0 never evicts.
MODEL_IDLE_MINUTES=15
# Send voice replies on WhatsApp when someone sends a voice note
REPLY_WITH_VOICE=false

# ---- Spoken replies in the dashboard ----
# edge = free Microsoft voices, no key. openai = an instructable voice, paid per
# use, and the only thing here that needs OPENAI_API_KEY.
TTS_PROVIDER=edge
DASHBOARD_VOICE_SW=sw-KE-ZuriNeural
DASHBOARD_VOICE_EN=en-KE-AsiliaNeural
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_TTS_STYLE=

# ---- Storage and retrieval ----
MESSAGE_RETENTION_DAYS=30
STYLE_RETRIEVAL=true
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Where the JSON log is written, rotated at 1MB x 3. Logs carry no message
# text, numbers or coordinates; set this to a path on a mounted volume if you
# want it to survive a redeploy. Defaults to data/app.log.
# APP_LOG_FILE=
# Only for scripts/build_style_index.py: your own name exactly as it appears in
# a WhatsApp chat export, so the script can tell your messages from theirs.
# EXPORT_OWNER_NAME=
